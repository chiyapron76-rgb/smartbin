model IssueReport {
  id           String      @id @default(uuid())
  task_item_id String?
  bin_id       String
  reporter_id  String?
  issue_type   IssueType
  description  String?
  created_at   DateTime    @default(now())
  status       IssueStatus @default(open)
  resolved_at  DateTime?
  resolved_by  String?

  bin Bin @relation(fields: [bin_id], references: [id])
}
