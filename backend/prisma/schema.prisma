// AUTO-GENERATED BASE — DO NOT REMOVE

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// === alert.prisma ===
model Alert {
  id          String    @id @default(uuid())
  binId       String
  alert_type  AlertType
  message     String
  created_at  DateTime  @default(now())
  resolved_at DateTime?
  resolved_by String?
  severity    AlertSeverity @default(low)

  bin SmartBin @relation(fields: [binId], references: [id])
}

// === apprating.prisma ===
model AppRating {
  id          String   @id @default(uuid())
  device_uuid String?
  rating      Int
  comment     String?
  created_at  DateTime @default(now())
  app_version String?
  platform    RatingPlatform
  device_info String?
}

// === bin.prisma ===
model Bin {
  id               String   @id @default(uuid())
  bin_code         String   @unique
  device_id        String
  name             String?
  area             String?
  capacity         Int?
  latitude         Float?
  longitude        Float?
  installed_at     DateTime?
  description      String?
  last_fill_level  Float?
  last_reported_at DateTime?
  status           BinStatus @default(normal)

  device SmartBin @relation(fields: [device_id], references: [id])
  taskItems        TaskItem[]
  citizenReports   CitizenReport[]
  issueReports     IssueReport[]
}

// === citizenreport.prisma ===
model CitizenReport {
  id           String   @id @default(uuid())
  bin_id       String
  issue_type   CitizenIssueType
  device_uuid  String?
  description  String?
  created_at   DateTime @default(now())
  status       CitizenReportStatus @default(open)
  resolved_at  DateTime?
  resolved_by  String?
  location_lat Float?
  location_lng Float?

  bin Bin @relation(fields: [bin_id], references: [id])
}

// === enums.prisma ===
enum BinDeviceStatus {
  active
  inactive
  maintenance
  offline
}

enum BinStatus {
  normal
  warning
  full
  offline
  error
}

enum AlertType {
  full
  offline
  error
  low_battery
  no_update
  sensor_error
  high_temp
}

enum AlertSeverity {
  low
  medium
  high
  critical
}

enum UserRole {
  superadmin
  admin
  collector
}

enum UserStatus {
  active
  inactive
}

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskItemStatus {
  pending
  completed
  skipped
}

enum IssueStatus {
  open
  resolved
}

enum IssueType {
  broken
  blocked
  sensor_error
  location_wrong
  vandalized
  others
}

enum CitizenIssueType {
  full
  dirty
  smelly
  broken
  misplaced
  others
}

enum CitizenReportStatus {
  open
  in_progress
  resolved
}

enum RatingPlatform {
  web
  mobile
}

// === issuereport.prisma ===
model IssueReport {
  id           String      @id @default(uuid())
  task_item_id String?
  bin_id       String
  reporter_id  String?
  issue_type   IssueType
  description  String?
  created_at   DateTime    @default(now())
  status       IssueStatus @default(open)
  resolved_at  DateTime?
  resolved_by  String?

  bin Bin @relation(fields: [bin_id], references: [id])
}

// === sensorrecord.prisma ===
model SensorRecord {
  id              String   @id @default(uuid())
  binId           String
  timestamp       DateTime @default(now())
  distance_cm     Float
  fill_percentage Float
  battery_voltage Float
  temperature     Float?
  error_code      String?
  raw_value       Json?

  bin SmartBin @relation(fields: [binId], references: [id])
}

// === smartbin.prisma ===
model SmartBin {
  id               String   @id @default(uuid())
  bin_code         String   @unique
  model            String?
  sensor_type      String?
  install_date     DateTime?
  last_heartbeat   DateTime?
  firmware_version String?
  network_type     String?
  is_online        Boolean? @default(true)
  location_lat     Float?
  location_lng     Float?
  address_note     String?
  zone             String?
  status           BinDeviceStatus @default(active)

  sensorRecords    SensorRecord[]
  alerts           Alert[]
  bins             Bin[]
}

// === task.prisma ===
model Task {
  id           String   @id @default(uuid())
  created_by   String
  assigned_to  String?
  created_at   DateTime @default(now())
  assigned_at  DateTime?
  completed_at DateTime?
  status       TaskStatus @default(pending)
  total_bins   Int?
  notes        String?
  priority     TaskPriority @default(medium)
  optimized_route Json?

  items TaskItem[]
}

// === taskitem.prisma ===
model TaskItem {
  id             String   @id @default(uuid())
  task_id        String
  bin_id         String
  order          Int
  status         TaskItemStatus @default(pending)
  completed_at   DateTime?
  collector_note String?
  gps_lat        Float?
  gps_lng        Float?

  task Task @relation(fields: [task_id], references: [id])
  bin  Bin  @relation(fields: [bin_id], references: [id])
}

// === user.prisma ===
model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          UserRole
  phone         String?
  status        UserStatus @default(active)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

