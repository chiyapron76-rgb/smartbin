{
  "name": "smartbin-backend",
  "version": "1.0.0",
  "scripts": {
    "start": "ts-node src/main.ts",
    "start:dev": "npm run prisma:merge && nodemon --watch 'src/**/*.ts' --exec ts-node src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/main.js",
    "prisma:merge": "node prisma/prisma-merge.js",
    "prisma:generate": "npm run prisma:merge && prisma generate",
    "prisma:migrate": "npm run prisma:merge && prisma migrate dev --name init",
    "prisma:migrate:deploy": "npm run prisma:merge && prisma migrate deploy",
    "prisma:studio": "npm run prisma:merge && prisma studio",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@prisma/client": "^6.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "express": "^4.18.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prisma": "^6.2.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
